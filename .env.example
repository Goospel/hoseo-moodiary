# /home/ec2-user/.env 의 템플릿.
#
# 실제 .env 는 gitignored — 이 파일을 복사해서 값만 채워 넣는다.
#
# 사용 위치
# - compose.yaml 이 같은 디렉토리의 .env 를 자동 로드 (docker compose 표준 동작).
# - SSH 로 EC2 에 직접 접속해서 mysql/curl 등 디버그할 때:
#     set -a; source ~/.env; set +a
#
# 운영 머지 전 체크 — 이 파일에 새 키 추가했으면 EC2 .env 도 업데이트 필수

DOCKER_HUB_USERNAME=your-dockerhub-username
RDS_ENDPOINT=your-rds-host.ap-northeast-2.rds.amazonaws.com
RDS_USERNAME=admin
RDS_PASSWORD=put-your-rds-password-here
JWT_SECRET=put-base64-encoded-32bytes-or-more-here

# CORS (PR 8) — FE 배포 origin 콤마 구분. 운영은 S3 endpoint URL 박아야 FE 가 호출 가능.
# 빈 문자열로 두면 compose 의 `:-` default 가 localhost dev origins 으로 fallback (운영에선 S3 차단).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OAuth2 (PR 12-final) — 운영은 반드시 OAUTH2_CLIENT_MODE=http, GOOGLE_OAUTH_CLIENT_ID 실 값 박기.
# stub 모드 (기본 fallback) 로 부팅되면 `stub:{PROVIDER}:{providerId}:{email}:{nickname}` 형식 토큰만 통과 — 운영에선 가짜 인증 통과 위험.
OAUTH2_CLIENT_MODE=http
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
