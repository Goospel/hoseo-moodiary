# /home/ec2-user/.env 의 템플릿.
#
# 실제 .env 는 gitignored — 이 파일을 복사해서 값만 채워 넣는다.
#
# 사용 위치
# - compose.yaml 이 같은 디렉토리의 .env 를 자동 로드 (docker compose 표준 동작).
# - SSH 로 EC2 에 직접 접속해서 mysql/curl 등 디버그할 때:
#     set -a; source ~/.env; set +a
#
# 운영 머지 전 체크 — 이 파일에 새 키 추가했으면 EC2 .env 도 업데이트 필수

DOCKER_HUB_USERNAME=your-dockerhub-username
RDS_ENDPOINT=your-rds-host.ap-northeast-2.rds.amazonaws.com
RDS_USERNAME=admin
RDS_PASSWORD=put-your-rds-password-here
JWT_SECRET=put-base64-encoded-32bytes-or-more-here
